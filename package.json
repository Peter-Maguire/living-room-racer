{
  "name": "living-room-racer",
  "version": "0.0.0",
  "private": true,
  "description": "Online multiplayer top-down 3D toy car racing game",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:client": "pnpm --filter @racer/client dev",
    "dev:server": "pnpm --filter @racer/server dev",
    "clean": "pnpm -r exec rimraf dist node_modules/.cache"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
